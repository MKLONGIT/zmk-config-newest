#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>


/ {
  chosen {
    zmk,kscan = &kscan0;
  };

  kscan0: kscan {
      compatible = "zmk,kscan-gpio-matrix";
      wakeup-source;
      diode-direction = "col2row";
      col-gpios
          = <&gpio0 30 GPIO_ACTIVE_HIGH>
          , <&gpio0 28 GPIO_ACTIVE_HIGH>
          , <&gpio0 31 GPIO_ACTIVE_HIGH>
          , <&gpio0 2 GPIO_ACTIVE_HIGH>
          , <&gpio0 29 GPIO_ACTIVE_HIGH>
          , <&gpio0 3 GPIO_ACTIVE_HIGH>
          , <&gpio1 15 GPIO_ACTIVE_HIGH>
          , <&gpio1 14 GPIO_ACTIVE_HIGH>
          , <&gpio0 16 GPIO_ACTIVE_HIGH>
          , <&gpio0 13 GPIO_ACTIVE_HIGH>
          , <&gpio0 15 GPIO_ACTIVE_HIGH>
          , <&gpio1 13 GPIO_ACTIVE_HIGH>
          , <&gpio1 12 GPIO_ACTIVE_HIGH>
          , <&gpio1 11 GPIO_ACTIVE_HIGH>
          , <&gpio1 10 GPIO_ACTIVE_HIGH>
          ;
      row-gpios
          = <&gpio0 23 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&gpio0 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&gpio0 19 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
          ;
  };

  keymap {
    compatible = "zmk,keymap";
    default_layer {
      bindings = <
        &kp ESC
        &kp N1
        &kp N2
        &kp N3
        &kp N4
        &kp N5
        &kp N6
        &kp N7
        &kp  N8
        &kp  N9
        &kp N0
        &kp MINUS
        &kp CARET
        &kp BSPC
        &kp HOME
        &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Z  &kp U  &kp  I    &kp  O  &kp  P &kp LEFT_BRACKET &kp PLUS &kp ENTER &kp DEL
        &kp CLCK &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp  K    &kp  L &kp SEMICOLON &kp SINGLE_QUOTE &kp HASH &kp RET &kp PG_UP
        &kp LSHFT     &kp Y  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp MINUS   &kp RSHFT   &kp UP &kp PG_DN
        &kp LCTRL &kp LMETA &kp LALT            &kp SPACE                   &kp RALT  &mo 1 &kp RMETA &kp RCTRL &kp LEFT &kp DOWN &kp RIGHT
      >;
      sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
    };
  };
};
